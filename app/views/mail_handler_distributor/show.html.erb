<%# Verteiler-Ansicht: ersetzt issues/show fuer Posteingang- und Alias-Verteiler-Tickets %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'mail_handler_distributor', :plugin => 'redmine_mail_handler' %>
  <%= javascript_include_tag 'mail_handler_distributor', :plugin => 'redmine_mail_handler' %>
<% end %>
<% html_title "##{@issue.id} #{@issue.subject}" %>

<div id="mh-distributor"
     class="mh-distributor mh-kind-<%= @distributor_kind %><%= ' mh-readonly' unless @distributor_can_move %>"
     data-issue-id="<%= @issue.id %>"
     data-kind="<%= @distributor_kind %>"
     data-move-url="<%= mail_handler_distributor_move_comment_path %>">

  <div class="mh-topbar">
    <span class="mh-title">
      <%= { root: 'Posteingang-Verteiler', alias: 'Alias-Verteiler', trash: 'Papierkorb' }[@distributor_kind] %>
      <%= link_to "##{@issue.id}", issue_path(@issue, :classic => 1), :title => 'Standard-Ticketansicht öffnen' %>
      <span class="mh-title-subject"><%= @issue.subject %></span>
      <% if @distributor_kind == :alias %>
        <span class="mh-title-project">· <%= link_to @issue.project.name, project_path(@issue.project) %></span>
      <% end %>
    </span>
    <span class="mh-topbar-right">
      <span class="mh-count"><%= @distributor_comments.length %> Kommentare</span>
      <%= link_to 'Standardansicht', issue_path(@issue, :classic => 1), :class => 'mh-classic-link' %>
    </span>
  </div>

  <div class="mh-comments" id="mh-comments">
    <% if @distributor_comments.empty? %>
      <div class="mh-empty">Keine Kommentare in diesem Verteiler.</div>
    <% end %>
    <% @distributor_comments.each do |c| %>
      <% journal = c.journal %>
      <div class="mh-comment"
           id="mh-comment-<%= journal.id %>"
           draggable="<%= @distributor_can_move ? 'true' : 'false' %>"
           data-journal-id="<%= journal.id %>"
           data-user-id="<%= journal.user_id %>">
        <span class="mh-c-move">
          <input type="text" class="mh-c-target" placeholder="Ticket-Nr." inputmode="numeric" autocomplete="off"
                 <%= 'disabled' unless @distributor_can_move %> />
          <button type="button" class="mh-c-go" title="In dieses Ticket verschieben" <%= 'disabled' unless @distributor_can_move %>>→</button>
        </span>
        <span class="mh-c-id"><%= link_to "##{journal.id}", issue_path(@issue, :classic => 1, :anchor => "note-#{c.indice}"), :title => "Kommentar #{c.indice} in der Standardansicht öffnen" %></span>
        <span class="mh-c-sep">|</span>
        <span class="mh-c-user"><%= journal.user ? journal.user.name : 'Anonym' %></span>
        <span class="mh-c-sep">|</span>
        <span class="mh-c-text"><%= c.preview.presence || '(kein Text)' %></span>
        <span class="mh-c-actions">
          <% if @distributor_kind == :trash %>
            <span class="mh-c-origin">
              <% if c.origin_issue %>aus <%= link_to "##{c.origin_issue.id}", issue_path(c.origin_issue), :title => c.origin_issue.subject %><% else %>Herkunft unbekannt<% end %>
            </span>
            <span class="mh-c-expires" title="<%= c.expires_at ? format_time(c.expires_at) : '' %>">
              <% if c.expires_at %>
                <% remaining = [((c.expires_at - Time.current) / 3600).ceil, 0].max %>
                löscht in <%= remaining %> h
              <% end %>
            </span>
            <% if c.origin_issue && @distributor_can_move %>
              <button type="button" class="mh-c-restore" data-target-id="<%= c.origin_issue.id %>" title="Zurück nach #<%= c.origin_issue.id %> <%= c.origin_issue.subject %>">↩ zurück nach #<%= c.origin_issue.id %></button>
            <% end %>
          <% end %>
          <span class="mh-c-suggest-wrap">
            <% if c.suggestion %>
              <% label = MailHandlerDistributor.target_label(@distributor_kind, c.suggestion) %>
              <a href="#" class="mh-c-suggest<%= ' mh-c-suggest-trash' if MailHandlerDistributor.trash?(c.suggestion) %>" data-target-id="<%= c.suggestion.id %>"
                 title="Vorschlag: bisher mehrfach hierhin verschoben (<%= label %>) – klicken zum Verschieben">
                <%= truncate(label, :length => 48) %>
              </a>
            <% end %>
          </span>
        </span>
        <%# Vollansicht fuer das Overlay (Mail-Stil); wird per Klick auf die Zeile geoeffnet %>
        <div class="mh-c-full" hidden>
          <div class="mh-mail-head">
            <div><span class="mh-mail-label">Von:</span> <%= journal.user ? journal.user.name : 'Anonym' %><% if journal.user && journal.user.mail.present? %> &lt;<%= journal.user.mail %>&gt;<% end %></div>
            <div><span class="mh-mail-label">Datum:</span> <%= format_time(journal.created_on) %></div>
            <div><span class="mh-mail-label">Ticket:</span> #<%= @issue.id %> <%= @issue.subject %> · Kommentar #<%= c.indice %> (Journal <%= journal.id %>)</div>
            <% atts = journal.details.select { |d| d.property == 'attachment' && d.value.present? } %>
            <% if atts.any? %>
              <div><span class="mh-mail-label">Anhänge:</span>
                <% atts.each do |d| %>
                  <% att = Attachment.find_by(id: d.prop_key) %>
                  <% if att %><%= link_to_attachment att, :download => true %><% else %><%= d.value %><% end %>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="mh-mail-body wiki"><%= textilizable(journal, :notes) %></div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mh-targets" id="mh-targets">
    <% unless @distributor_kind == :trash %>
      <div class="mh-targets-head">
        <span class="mh-targets-title">
          <% if @distributor_kind == :root %>
            Alias-Verteiler <span class="mh-hint">– Kommentar per Drag &amp; Drop hierher ziehen</span>
          <% else %>
            Tickets in <strong><%= @issue.project.name %></strong>
            <span class="mh-hint">– Tracker anklicken, um nur diesen als Raster zu zeigen</span>
            <label class="mh-closed-toggle"><input type="checkbox" id="mh-show-closed" /> geschlossene anzeigen</label>
          <% end %>
        </span>
        <span class="mh-targets-tools">
          <input type="search" id="mh-search" class="mh-search" placeholder="Ziele filtern …" autocomplete="off" />
          <% if @distributor_trash %>
            <div class="mh-box mh-trash-box mh-drop" data-target-id="<%= @distributor_trash.id %>" title="Kommentar hierher ziehen: wird <%= MailHandlerDistributor.trash_retention_hours %> h aufbewahrt und dann gelöscht">
              <span class="mh-trash-icon">🗑</span>
              <span class="mh-trash-text"><%= link_to 'Papierkorb', issue_path(@distributor_trash) %><small><%= MailHandlerDistributor.trash_retention_hours %> h</small></span>
            </div>
          <% end %>
        </span>
      </div>
    <% end %>

    <% if @distributor_kind == :root %>
      <% if @distributor_aliases.blank? %>
        <div class="mh-empty">Keine Alias-Verteiler in der Adress-Matrix konfiguriert.</div>
      <% end %>
      <div class="mh-alias-grid">
        <% @distributor_aliases.each do |a| %>
          <div class="mh-box mh-alias-box mh-drop" data-target-id="<%= a.issue.id %>"
               data-search="<%= [a.project&.identifier, a.project&.name, a.issue.id, a.issue.subject, a.email].compact.join(' ').downcase %>">
            <div class="mh-box-project-id" title="<%= a.project ? a.project.name : '' %> · Ticket #<%= a.issue.id %>"><%= link_to(a.project ? MailHandlerDistributor.short_name(a.project.name) : "##{a.issue.id}", issue_path(a.issue)) %></div>
            <div class="mh-box-alias"><%= a.email %></div>
          </div>
        <% end %>
      </div>
    <% elsif @distributor_kind == :alias %>
      <% if @distributor_columns.blank? %>
        <div class="mh-empty">Keine Tickets in diesem Projekt.</div>
      <% end %>
      <div class="mh-tracker-columns" id="mh-tracker-columns">
        <% @distributor_columns.each do |col| %>
          <div class="mh-tracker-col" data-tracker-id="<%= col.tracker.id %>">
            <div class="mh-tracker-head" title="Nur diesen Tracker anzeigen / zurück">
              <span class="mh-tracker-name"><%= col.tracker.name %></span>
              <span class="mh-tracker-count"><%= col.issues.count { |i| !i.closed? } %>/<%= col.issues.length %></span>
            </div>
            <div class="mh-tracker-body">
              <% col.issues.each do |i| %>
                <div class="mh-box mh-issue-box mh-drop<%= ' mh-closed' if i.closed? %>" data-target-id="<%= i.id %>"
                     data-search="<%= [i.id, i.subject, i.status.name, col.tracker.name].join(' ').downcase %>">
                  <div class="mh-box-id"><%= link_to "##{i.id}", issue_path(i) %> <span class="mh-box-status"><%= i.status.name %></span></div>
                  <div class="mh-box-subject"><%= i.subject %></div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="mh-trash-info">
        <strong>Papierkorb.</strong> Kommentare bleiben hier <%= @distributor_retention_hours %> Stunden und werden dann automatisch gelöscht.
        Mit „↩ zurück“ landet ein Kommentar wieder in dem Ticket, aus dem er verschoben wurde. Über das Ticket-Nr.-Feld kann er in ein beliebiges Ticket verschoben werden.
      </div>
    <% end %>
  </div>

  <div class="mh-toast" id="mh-toast" hidden></div>

  <div class="mh-overlay" id="mh-overlay" hidden>
    <div class="mh-overlay-box" role="dialog" aria-modal="true">
      <div class="mh-overlay-bar">
        <span class="mh-overlay-title">Kommentar</span>
        <span class="mh-overlay-actions">
          <a href="#" class="mh-overlay-classic" target="_blank">In Ticketansicht öffnen</a>
          <button type="button" class="mh-overlay-close" title="Schließen (Esc)">×</button>
        </span>
      </div>
      <div class="mh-overlay-content" id="mh-overlay-content"></div>
    </div>
  </div>
</div>
